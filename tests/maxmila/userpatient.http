### Caregiver <-> patient assignments

###
# @name Assign one patient (manager/admin)
POST {{maxmila.baseUrl}}/assign/patient
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_id": 1,
  "notes": "Primary caregiver"
}

###
# @name Assign many patients (manager/admin)
POST {{maxmila.baseUrl}}/assign/patients
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_ids": [1, 2, 3],
  "notes": "Weekly rotation"
}

###
# @name Unassign many patients (manager/admin)
POST {{maxmila.baseUrl}}/unassign/patients
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_ids": [2, 3]
}

###
# @name My assigned patients
GET {{maxmila.baseUrl}}/assigned/patients/{{maxmila.caregiver.id}}
Authorization: {{maxmila.caregiver.token}}

###
# @name My assigned patients with addresses (home screen payload)
GET {{maxmila.baseUrl}}/assigned/patients/addresses/{{maxmila.caregiver.id}}
Authorization: {{maxmila.caregiver.token}}

###
# @name Patients not assigned to me
GET {{maxmila.baseUrl}}/unassigned/patients/{{maxmila.caregiver.id}}
Authorization: {{maxmila.caregiver.token}}

###
# @name Patients not assigned to me, with addresses
GET {{maxmila.baseUrl}}/unassigned/patients/addresses/{{maxmila.caregiver.id}}
Authorization: {{maxmila.caregiver.token}}

###
# @name Caregivers assigned to a patient (manager/admin)
GET {{maxmila.baseUrl}}/assigned/users/1
Authorization: {{maxmila.manager.token}}

###
# @name Caregivers not assigned to a patient (manager/admin)
GET {{maxmila.baseUrl}}/unassigned/users/1
Authorization: {{maxmila.manager.token}}

###
# @name Another caregiver's assignments as caregiver - expect 403
GET {{maxmila.baseUrl}}/assigned/patients/1
Authorization: {{maxmila.caregiver.token}}
