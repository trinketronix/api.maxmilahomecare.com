###
# @name Send Email (administrator only)
POST {{maxmila.baseUrl}}/send/email
Content-Type: application/json
Authorization: {{maxmila.administrator.token}}

{
  "to": "someone@example.com",
  "subject": "Maxmila API test",
  "body": "Hello from the API test suite"
}

###
# @name Send Email as caregiver - expect 403
POST {{maxmila.baseUrl}}/send/email
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "to": "someone@example.com",
  "subject": "nope",
  "body": "nope"
}
