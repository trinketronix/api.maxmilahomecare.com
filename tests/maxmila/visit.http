### Visit endpoints
### Progress: -1 canceled, 0 scheduled, 1 checked in, 2 checked out, 3 approved
### address_id 0 = Community (no fixed address)

###
# @name Schedule Visit (self) - total_hours 0..24, extra_minutes 0|15|30|45, duration > 0
POST {{maxmila.baseUrl}}/visit/schedule
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_id": 1,
  "address_id": 1,
  "visit_date": "{{$isoTimestamp}}",
  "start_time": "{{$datetime 'YYYY-MM-DD'}} 09:00:00",
  "total_hours": 2,
  "extra_minutes": 30,
  "note": "Morning visit"
}

###
# @name Schedule minutes-only visit at the Community address
POST {{maxmila.baseUrl}}/visit/schedule
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_id": 1,
  "address_id": 0,
  "visit_date": "{{$datetime 'YYYY-MM-DD' 1}}",
  "total_hours": 0,
  "extra_minutes": 15
}

###
# @name Schedule for another caregiver (manager/admin)
POST {{maxmila.baseUrl}}/visit/schedule
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_id": 1,
  "address_id": 1,
  "visit_date": "{{$datetime 'YYYY-MM-DD' 2}}",
  "total_hours": 1
}

###
# @name Schedule with zero duration - expect 400
POST {{maxmila.baseUrl}}/visit/schedule
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "user_id": {{maxmila.caregiver.id}},
  "patient_id": 1,
  "address_id": 0,
  "visit_date": "{{$datetime 'YYYY-MM-DD' 3}}",
  "total_hours": 0,
  "extra_minutes": 0
}

###
# @name Schedule for someone else as caregiver - expect 403
POST {{maxmila.baseUrl}}/visit/schedule
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "user_id": 1,
  "patient_id": 1,
  "address_id": 0,
  "visit_date": "{{$datetime 'YYYY-MM-DD' 3}}",
  "total_hours": 1
}

###
# @name All visits (manager/admin, pre-sorted)
GET {{maxmila.baseUrl}}/visits
Authorization: {{maxmila.manager.token}}

###
# @name My visits
GET {{maxmila.baseUrl}}/user/visits/{{maxmila.caregiver.id}}
Authorization: {{maxmila.caregiver.token}}

###
# @name Visits of a patient (manager/admin)
GET {{maxmila.baseUrl}}/patient/visits/1
Authorization: {{maxmila.manager.token}}

###
# @name Get Visit
GET {{maxmila.baseUrl}}/visit/1
Authorization: {{maxmila.caregiver.token}}

###
# @name Get Visit not found - expect 404
GET {{maxmila.baseUrl}}/visit/999999
Authorization: {{maxmila.caregiver.token}}

###
# @name Update Visit (owner while scheduled; manager/admin until approved/canceled)
PUT {{maxmila.baseUrl}}/visit/1
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "start_time": "{{$datetime 'YYYY-MM-DD'}} 10:00:00",
  "total_hours": 3,
  "extra_minutes": 0,
  "note": "Moved to 10am"
}

###
# @name Update Visit with no fields - expect 400
PUT {{maxmila.baseUrl}}/visit/1
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{}

###
# @name Check In
PUT {{maxmila.baseUrl}}/visit/1/checkin
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{}

###
# @name Check Out
PUT {{maxmila.baseUrl}}/visit/1/checkout
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{}

###
# @name Approve (manager/admin)
PUT {{maxmila.baseUrl}}/visit/1/approve
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Cancel (note required)
PUT {{maxmila.baseUrl}}/visit/2/cancel
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "note": "Patient rescheduled"
}

###
# @name Cancel without note - expect 400
PUT {{maxmila.baseUrl}}/visit/2/cancel
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{}

###
# @name Archive visit (manager/admin)
PUT {{maxmila.baseUrl}}/visit/3/status/archived
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Soft-delete visit (manager/admin)
PUT {{maxmila.baseUrl}}/visit/3/status/deleted
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Restore visit to visible (manager/admin)
PUT {{maxmila.baseUrl}}/visit/3/status/visible
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}
