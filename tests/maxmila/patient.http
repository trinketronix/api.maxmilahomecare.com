### Patient endpoints (manager/admin)

###
# @name Create Patient (minimal)
POST {{maxmila.baseUrl}}/patient/new
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "firstname": "Jane",
  "lastname": "Doe",
  "phone": "313-555-0100"
}

###
# @name Create Patient with address and HHAexchange ids
POST {{maxmila.baseUrl}}/patient/new
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "patient": "P-10001",
  "admission": "A-20001",
  "firstname": "John",
  "middlename": "Q",
  "lastname": "Public",
  "gender": "male",
  "birthdate": "1945-03-12",
  "phone": "313-555-0101",
  "phone2": "313-555-0102",
  "address": {
    "type": "House",
    "address": "100 Main St",
    "city": "Detroit",
    "county": "Wayne",
    "state": "MI",
    "zipcode": "48226",
    "latitude": 42.3314,
    "longitude": -83.0458
  }
}

###
# @name Create Patient missing phone - expect 400
POST {{maxmila.baseUrl}}/patient/new
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "firstname": "No",
  "lastname": "Phone"
}

###
# @name Create Patient as caregiver - expect 403
POST {{maxmila.baseUrl}}/patient/new
Content-Type: application/json
Authorization: {{maxmila.caregiver.token}}

{
  "firstname": "Not",
  "lastname": "Allowed",
  "phone": "000-000-0000"
}

###
# @name List Patients (204 with "No records found" when empty)
GET {{maxmila.baseUrl}}/patients
Authorization: {{maxmila.manager.token}}

###
# @name List Patients with addresses
GET {{maxmila.baseUrl}}/patients/addresses
Authorization: {{maxmila.manager.token}}

###
# @name Get Patient
GET {{maxmila.baseUrl}}/patient/1
Authorization: {{maxmila.manager.token}}

###
# @name Get Patient not found - expect 404
GET {{maxmila.baseUrl}}/patient/999999
Authorization: {{maxmila.manager.token}}

###
# @name Update Patient
PUT {{maxmila.baseUrl}}/patient/1
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "phone": "313-555-0199",
  "admission": "A-20001-B"
}

###
# @name Update Patient status to inactive via PUT (0 = inactive, blocks new visits)
PUT {{maxmila.baseUrl}}/patient/1
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{
  "status": 0
}

###
# @name Activate Patient
PUT {{maxmila.baseUrl}}/patient/1/activate
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Inactivate Patient
PUT {{maxmila.baseUrl}}/patient/1/inactivate
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Archive Patient
PUT {{maxmila.baseUrl}}/patient/1/archivate
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Soft-delete Patient
PUT {{maxmila.baseUrl}}/patient/1/delete
Content-Type: application/json
Authorization: {{maxmila.manager.token}}

{}

###
# @name Patient visits (manager/admin)
GET {{maxmila.baseUrl}}/patient/visits/1
Authorization: {{maxmila.manager.token}}

### ---- Pagination & filters ----

###
# @name Patients page 1 of 25
GET {{maxmila.baseUrl}}/patients?page=1&per_page=25
Authorization: {{maxmila.manager.token}}

###
# @name Search patients by name or HHAexchange id (no page -> all matches)
GET {{maxmila.baseUrl}}/patients?search=smith
Authorization: {{maxmila.manager.token}}

###
# @name Inactive patients with addresses, paged
GET {{maxmila.baseUrl}}/patients/addresses?status=0&page=1&per_page=25
Authorization: {{maxmila.manager.token}}

###
# @name Invalid page - expect 400
GET {{maxmila.baseUrl}}/patients?page=0
Authorization: {{maxmila.manager.token}}
