### Photo uploads - multipart/form-data, the image is the first file field.
### Content is type-checked server side (JPEG/PNG/GIF/WEBP); the file name's extension is ignored.

###
# @name Upload My Photo
POST {{maxmila.baseUrl}}/user/upload/photo
Authorization: {{maxmila.caregiver.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.png"
Content-Type: image/png

< ./img/avatar_600.png
--WebAppBoundary--

###
# @name Update My Photo (same rules, separate route kept for the apps)
POST {{maxmila.baseUrl}}/user/update/photo
Authorization: {{maxmila.caregiver.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.png"
Content-Type: image/png

< ./img/avatar_600.png
--WebAppBoundary--

###
# @name Upload Another User's Photo (manager/admin)
POST {{maxmila.baseUrl}}/user/77/upload/photo
Authorization: {{maxmila.manager.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.png"
Content-Type: image/png

< ./img/avatar_600.png
--WebAppBoundary--

###
# @name Upload a non-image claiming to be an image - expect 400 Invalid file type
POST {{maxmila.baseUrl}}/user/upload/photo
Authorization: {{maxmila.caregiver.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="evil.php"
Content-Type: image/jpeg

<?php echo "not an image"; ?>
--WebAppBoundary--

###
# @name Upload with JSON content type - expect 415
POST {{maxmila.baseUrl}}/user/upload/photo
Authorization: {{maxmila.caregiver.token}}
Content-Type: application/json

{}

###
# @name Upload Patient Photo (manager/admin)
POST {{maxmila.baseUrl}}/patient/1/upload/photo
Authorization: {{maxmila.manager.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.png"
Content-Type: image/png

< ./img/avatar_600.png
--WebAppBoundary--

###
# @name Update Patient Photo (manager/admin)
POST {{maxmila.baseUrl}}/patient/1/update/photo
Authorization: {{maxmila.manager.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="photo"; filename="avatar.png"
