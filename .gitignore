# Ignore .idea folder (used by JetBrains IDEs like PhpStorm)
.idea/

# Ignore macOS system files
.DS_Store

# Ignore .htaccess files
.htaccess
.htaccess_prod
.htaccess_test

# Ignore .ftpquota file and FTP deploy state
.ftpquota
.ftp-deploy-sync-state.json

# Dependencies, logs, local tooling
vendor/
composer.lock
*.log

# Ignore secrets.txt
secrets.txt

# REST API confidential values
http-client.env.json
/tests/maxmila/img/avril.png

# Uploaded photos are runtime data; keep only the protective .htaccess
user/photo/*
patient/photo/*
!user/photo/.htaccess
!patient/photo/.htaccess

# Backup/seed payloads contain real personal data and must never be committed
tests/maxmila/bulk-backup.http
tests/maxmila/*backup*.http




# Cron credentials live next to the cron script on the server, never in git
cronjobs/.env
